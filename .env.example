# Server Configuration
PORT=7000
HOST=0.0.0.0

# Optional Global Default Credentials (if not specified per user URL)
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=

# Optional Rate Limiting & Cache Tuning
# Minimum delay in milliseconds between Archive.org requests (default: 150)
RATE_LIMIT_DELAY_MS=150
# Maximum concurrent requests to Archive.org (default: 5)
MAX_CONCURRENT_REQUESTS=5
# Cache TTL in milliseconds for metadata (default: 1800000 - 30 minutes)
CACHE_TTL_MS=1800000
